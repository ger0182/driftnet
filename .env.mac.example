# 複製成 .env 後再填入實際值；.env 已被 Git 與 Docker build context 排除。

# 必填：建議使用 `openssl rand -base64 32` 產生長密碼。
DRIFTNET_TOKEN=

DRIFTNET_LANGUAGE=Traditional Chinese (Taiwan)
DRIFTNET_LOCALE=zh-TW

# AI 模型，選用。不需要 AI 摘要時保持空白即可。
DRIFTNET_LLM_PROVIDER=
DRIFTNET_LLM_MODEL=
DRIFTNET_LLM_API_KEY=
DRIFTNET_LLM_BASE_URL=

# Cloudflare Zero Trust 建立 remotely-managed Tunnel 後取得；未設定時只有 Tunnel 無法連線。
CLOUDFLARE_TUNNEL_TOKEN=
