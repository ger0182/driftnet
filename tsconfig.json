{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "@driftnet/core": ["./packages/core/src/index.ts"],
      "@driftnet/core/*": ["./packages/core/src/*"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "apps/*/src", "apps/*/test", "api"]
}
