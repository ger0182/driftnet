{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{apps/server/src/**,apps/server/public/**,packages/core/src/**}"
    }
  },
  "rewrites": [
    {
      "source": "/:dnPath*",
      "destination": "/api/index?dnPath=:dnPath*"
    }
  ]
}
