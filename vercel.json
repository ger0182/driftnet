{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.mjs",
  "functions": {
    "api/index.js": {
      "includeFiles": "{.vercel-generated/**,apps/server/public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/:dnPath*",
      "destination": "/api/index?dnPath=:dnPath*"
    }
  ]
}
