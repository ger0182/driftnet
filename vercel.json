{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "functions": {
    "api/index.ts": {
      "includeFiles": "apps/server/public/**"
    }
  },
  "rewrites": [
    {
      "source": "/:dnPath*",
      "destination": "/api/index?dnPath=:dnPath*"
    }
  ]
}
