# Required: keep the deployed catalogue private.
DRIFTNET_ACCESS=private
DRIFTNET_TOKEN=

# GitHub repository used as the durable data store.
# IMPORTANT: this repository should be PRIVATE.
DRIFTNET_GITHUB_TOKEN=
DRIFTNET_DATA_REPO=ger0182/driftnet-data
DRIFTNET_DATA_BRANCH=main
DRIFTNET_DATA_PATH=data/driftnet-state.md

# Optional. Vercel normally supplies its deployment URL automatically.
DRIFTNET_PUBLIC_URL=

# Safety override. Leave unset unless you deliberately accept publishing all
# persisted Driftnet data in a public GitHub repository.
# DRIFTNET_ALLOW_PUBLIC_DATA_REPO=1
